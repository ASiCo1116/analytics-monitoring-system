# Copy to .env before starting: cp .env.example .env
# The defaults work as-is for `docker compose up`.

# ---------- Database (MariaDB container) ----------
# Root password of the MariaDB server
MARIADB_ROOT_PASSWORD=rootpass
# Application database, user and password (created on first start)
MARIADB_DATABASE=analytics
MARIADB_USER=app
MARIADB_PASSWORD=apppass

# ---------- Backend ----------
# Where the backend reaches MariaDB; it logs in with the MARIADB_* account
# above. Inside Docker the host is the `db` service; the local pixi tasks
# (dev, migrate, seed) override it with localhost.
DB_HOST=db
DB_PORT=3306
# Secret used to sign JWTs (HS256: at least 32 bytes). Change it for any
# real deployment.
JWT_SECRET_KEY=change-me-in-production-at-least-32-bytes
# Access token lifetime in minutes
JWT_EXPIRE_MINUTES=60

# Passwords of the seeded test accounts (admin / user / viewer)
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_PASSWORD=User@1234
SEED_VIEWER_PASSWORD=Viewer@1234

# Realtime metric simulator on/off
SIMULATOR_ENABLED=true
# Comma-separated list of simulated servers
SIMULATOR_SERVERS=server-1,server-2,server-3
# A value strictly greater than its threshold is flagged as an anomaly
THRESHOLD_CPU=90
THRESHOLD_MEMORY=90
THRESHOLD_TEMPERATURE=80
# Flush buffered metrics every N seconds, or as soon as N rows are buffered
BATCH_INTERVAL_SECONDS=10
BATCH_SIZE=100

# Python logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- Frontend ----------
# Where the Streamlit app reaches the backend (from inside the frontend container)
BACKEND_URL=http://backend:8000
BACKEND_WS_URL=ws://backend:8000

# ---------- Shared ----------
# Display timezone; also used by the backend for timezone-less input and trend buckets
APP_TIMEZONE=Asia/Taipei
